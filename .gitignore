# =========================
# EnterpriseQA .gitignore
# =========================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/

# ---- Node.js / 前端 ----
node_modules/
dist/
.cache/

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 环境变量 / 密钥 ----
.env
.env.local
.env.*.local

# ---- 数据库文件 ----
*.sqlite3
chroma_data/

# ---- 上传文件（运行时生成）----
uploads/

# ---- 日志 ----
*.log
logs/

# ---- 测试 / 临时 ----
tmp/
temp/
